#!/usr/bin/env python3
"""Run pinned native Beads against the Git common directory's shared store."""

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import signal
import shutil
import sys
import tempfile
import subprocess
import tomllib


class Refusal(Exception):
    pass


def refuse(message):
    raise Refusal(message)


def digest(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def directory(path):
    if path.is_symlink():
        refuse(f"shared runtime path must not be a symlink: {path}")
    path.mkdir(mode=0o700, exist_ok=True)
    if not path.is_dir():
        refuse(f"not a directory: {path}")


def release_pin():
    target = {
        ("Darwin", "arm64"): "aarch64-apple-darwin",
        ("Linux", "x86_64"): "x86_64-unknown-linux-gnu",
    }.get((platform.system(), platform.machine()))
    manifest = Path(__file__).resolve().with_name("work-state-beads-1.1.2.toml")
    with manifest.open("rb") as stream:
        pin = tomllib.load(stream)
    for entry in pin["targets"]:
        if entry["target"] == target:
            return entry
    refuse("this platform has no verified Beads release in the pinned manifest")


def install(arguments, state, pin):
    parser = argparse.ArgumentParser(prog="work-state install")
    parser.add_argument("--archive", required=True, type=Path)
    parser.add_argument("--bd", required=True, type=Path)
    options = parser.parse_args(arguments)
    if options.archive.name != pin["archive"]:
        refuse(f"expected archive filename {pin['archive']}")
    if digest(options.archive) != pin["archive_sha256"]:
        refuse("archive SHA256 does not match the pinned release")
    destination = state / "bd"
    if destination.is_symlink():
        refuse("installed bd must not be a symlink")
    descriptor, name = tempfile.mkstemp(prefix=".bd-install-", dir=state)
    staged = Path(name)
    try:
        with os.fdopen(descriptor, "wb") as output, options.bd.open("rb") as source:
            shutil.copyfileobj(source, output)
            output.flush()
            os.fsync(output.fileno())
        if digest(staged) != pin["binary_sha256"]:
            refuse("binary SHA256 does not match the pinned release")
        staged.chmod(0o700)
        os.replace(staged, destination)
    finally:
        staged.unlink(missing_ok=True)
    print(destination)


FILE_FLAGS = {
    "--body-file", "--design-file", "--file", "--input", "--output", "--graph",
    "--agents-template", "--schema-file", "--rules-file", "--reason-file",
}
ROUTING_FLAGS = {"--db", "--directory", "--global", "--repo", "--database"}
INIT_FLAGS = {
    "--force", "--reinit-local", "--destroy-token", "--discard-remote",
    "--server", "--shared-server", "--proxied-server", "--external",
    "--stealth", "--setup-exclude", "--contributor", "--team", "--from-jsonl",
}


def caller_path(value, cwd):
    if not value or value == "-" or Path(value).is_absolute():
        return value
    return str(cwd / value)


def command_help(binary, command, private, child, lock):
    response = subprocess.run(
        [str(binary), *command, "--help"], cwd=private, env=child,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, pass_fds=(lock.fileno(),),
    )
    if response.returncode:
        sys.stdout.write(response.stdout)
        sys.stderr.write(response.stderr)
        sys.exit(response.returncode)
    flags = {}
    for match in re.finditer(r"^\s+(?:(-\w), )?(--[\w-]+)(?: (\S+))?\s{2,}", response.stdout, re.MULTILINE):
        short, long, kind = match.groups()
        flags[long] = (long, kind is not None)
        if short:
            flags[short] = flags[long]
    commands = set(re.findall(r"^  ([\w-]+) {2,}", response.stdout, re.MULTILINE))
    return flags, commands


def native_arguments(arguments, cwd, binary, private, child, lock):
    result = []
    positionals = []
    actor = os.environ.get("BEADS_ACTOR", "")
    toggles = {}
    command = []
    flags, commands = command_help(binary, command, private, child, lock)
    index = 0
    literal = False
    while index < len(arguments):
        argument = arguments[index]
        if not literal and argument == "--":
            literal = True
            result.append(argument)
        elif not literal and argument.startswith("-") and argument != "-":
            pending = argument
            while pending:
                if pending.startswith("--"):
                    name, equals, value = pending.partition("=")
                    pending = ""
                else:
                    name = pending[:2]
                    value = pending[2:]
                    equals = value.startswith("=")
                    if equals:
                        value = value[1:]
                    pending = ""
                canonical, takes_value = flags.get(name, (name, False))
                if canonical in ROUTING_FLAGS or name == "-C":
                    refuse(f"{name} cannot override the shared Beads store")
                if canonical.startswith(("--server-", "--proxied-server-")) or canonical in {"--server", "--shared-server", "--proxied-server"}:
                    refuse("the shared store uses embedded Dolt, not a server")
                if command == ["init"] and canonical in INIT_FLAGS:
                    refuse(f"{name} is not permitted for non-destructive shared initialization")
                if takes_value:
                    if not value and not equals:
                        index += 1
                        if index == len(arguments):
                            refuse(f"{name} requires a value")
                        value = arguments[index]
                    if canonical == "--actor":
                        actor = value
                    if canonical == "--dolt-auto-commit" and value != "on":
                        refuse("Dolt auto-commit must remain on")
                    if canonical in FILE_FLAGS:
                        value = caller_path(value, cwd)
                    elif canonical == "--metadata" and value.startswith("@"):
                        value = "@" + caller_path(value[1:], cwd)
                    result.extend((canonical, value))
                else:
                    if not name.startswith("--") and value and not equals:
                        pending = "-" + value
                        value = ""
                    toggles[canonical] = not equals or value.lower() not in {"false", "0", "f"}
                    result.append(canonical + ("=" + value if equals else ""))
        else:
            if not command or (not positionals and argument in commands):
                command.append(argument)
                flags, commands = command_help(binary, command, private, child, lock)
            else:
                positionals.append(argument)
                if command == ["import"]:
                    argument = caller_path(argument, cwd)
            result.append(argument)
        index += 1
    help_requested = toggles.get("--help", False) or command[:1] == ["help"]
    claims = toggles.get("--claim", False) or toggles.get("--claim-next", False)
    claims |= toggles.get("--continue", False) and not toggles.get("--no-auto", False)
    if claims and not help_requested and not actor.strip():
        refuse("claims require an explicit unique --actor or BEADS_ACTOR (not a shared Git username)")
    if actor.strip():
        result[:0] = ("--actor", actor)
    if command[:1] and command[0] in {"repo", "worktree", "hooks", "setup", "bootstrap", "upgrade"}:
        refuse(f"{command[0]} is not a shared-store operation")
    if command[:1] == ["dolt"] and len(command) > 1 and command[1] in {"set", "start", "stop", "killall", "clean-databases"}:
        refuse("Dolt server and storage routing changes are not shared-store operations")
    if command[:1] == ["config"] and len(command) > 1 and command[1] in {"set", "set-many", "unset"}:
        protected = ("repos.", "routing.", "contributor.", "dolt.data-dir", "dolt.mode",
                     "dolt.shared-server", "dolt.auto-", "export.auto", "export.git-add",
                     "import.auto", "backup.enabled", "no-git-ops", "no-hooks")
        if any(item.partition("=")[0].startswith(protected) for item in positionals):
            refuse("configuration cannot override shared-store routing or automatic-operation policy")
    if command == ["init"] and not help_requested:
        boundary = result.index("--") if "--" in result else len(result)
        result[boundary:boundary] = ("--skip-agents", "--skip-hooks", "--non-interactive")
    return command[0] if command else None, result, help_requested


def environment(store, private):
    for key, value in os.environ.items():
        if not value:
            continue
        if key in {"BEADS_DIR", "BEADS_DB", "BD_DB", "BEADS_DOLT_DATA_DIR", "BEADS_DOLT_PROXIED_SERVER", "BD_DOLT_DATA_DIR"} or key.startswith(("BEADS_DOLT_SERVER_", "BEADS_DOLT_SHARED_", "BEADS_PROXIED_", "BD_ROUTING_", "BD_REPOS_")):
            refuse(f"unset {key}; work-state binds the shared embedded store")
    child = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    child.update({
        "BEADS_DIR": str(store),
        "BEADS_DOLT_SHARED_SERVER": "false",
        "BD_DOLT_SHARED_SERVER": "false",
        "BD_DOLT_AUTO_START": "false",
        "BD_DOLT_AUTO_COMMIT": "on",
        "BD_DOLT_AUTO_PUSH": "false",
        "BD_EXPORT_AUTO": "false",
        "BD_EXPORT_GIT_ADD": "false",
        "BD_IMPORT_AUTO": "false",
        "BD_BACKUP_ENABLED": "false",
        "BD_NO_GIT_OPS": "true",
        "BD_NO_HOOKS": "true",
        "BD_ROUTING_MODE": "explicit",
        "BD_ROUTING_DEFAULT": ".",
        "BD_ROUTING_MAINTAINER": ".",
        "BD_ROUTING_CONTRIBUTOR": ".",
        "BD_CONTRIBUTOR_AUTO_ROUTE": "false",
        "BD_NON_INTERACTIVE": "1",
        "BD_DISABLE_METRICS": "1",
        "GIT_CEILING_DIRECTORIES": str(private.parent),
        "PWD": str(private),
    })
    return child


INIT_CONFIG = "dolt.auto-commit: on\ndolt.auto-push: false\nexport.auto: false\nno-git-ops: true\n"


def check_store(store, command):
    """Seed native config so fresh init cannot rediscover an ancestor store."""
    if store.is_symlink():
        refuse("shared store must not be a symlink")
    for name in ("redirect", ".env"):
        if (store / name).exists():
            refuse(f"shared store must not contain a {name} routing override")
    metadata = store / "metadata.json"
    if metadata.exists():
        if metadata.is_symlink():
            refuse("shared metadata must not be a symlink")
        config = json.loads(metadata.read_text())
        if config.get("dolt_mode", "embedded") != "embedded":
            refuse("shared metadata must select embedded Dolt")
        if config.get("dolt_data_dir"):
            refuse("shared metadata must use its default embedded data directory")
        if command == "init":
            refuse("shared store is already initialized; existing data was left untouched")
    elif command == "init":
        if store.exists() and any(store.iterdir()):
            refuse("shared store is nonempty but not initialized; inspect it before recovery")
        directory(store)
        with (store / "config.yaml").open("x") as stream:
            stream.write(INIT_CONFIG)
    elif command not in {None, "help", "version"}:
        refuse("shared store is not initialized; run work-state init --prefix plasmosome")


def initialize(binary, arguments, store, child, lock):
    process = subprocess.Popen(
        [str(binary), "--dolt-auto-commit=on", *arguments], env=child,
        pass_fds=(lock.fileno(),),
    )
    handlers = {}
    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        handlers[number] = signal.signal(number, lambda received, frame: process.send_signal(received))
    try:
        code = process.wait()
    finally:
        for number, handler in handlers.items():
            signal.signal(number, handler)
        seed = store / "config.yaml"
        if set(store.iterdir()) == {seed} and not seed.is_symlink() and seed.read_text() == INIT_CONFIG:
            seed.unlink()
    if code < 0:
        signal.signal(-code, signal.SIG_DFL)
        os.kill(os.getpid(), -code)
    sys.exit(code)


def main():
    cwd = Path.cwd()
    root = Path(__file__).resolve().parent.parent
    git_env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    discovery = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        cwd=root, env=git_env, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if discovery.returncode:
        refuse("launcher must live in a Git worktree")
    common = Path(discovery.stdout.rstrip("\n")).resolve(strict=True)
    state = common / "plasmosome-beads"
    directory(state)
    pin = release_pin()
    descriptor = os.open(state / "command.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "r+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        arguments = sys.argv[1:]
        if arguments and arguments[0] == "install":
            install(arguments[1:], state, pin)
            return
        binary = state / "bd"
        if binary.is_symlink() or not binary.is_file():
            refuse("pinned native bd is not installed; use work-state install --archive PATH --bd PATH")
        if digest(binary) != pin["binary_sha256"]:
            refuse("installed bd SHA256 does not match the pinned release")
        store = state / "store"
        private = state / "cwd"
        directory(private)
        if (private / ".git").exists() or (private / ".beads").exists():
            refuse("private invocation directory must not contain a Git or Beads checkout")
        child = environment(store, private)
        command, arguments, help_requested = native_arguments(arguments, cwd, binary, private, child, lock)
        if not help_requested:
            check_store(store, command)
        if command != "init" and (store / "metadata.json").is_file():
            # Native reverse discovery assumes a .beads basename; bind the metadata directory.
            arguments.insert(0, f"--db={store}")
        os.chdir(private)
        os.set_inheritable(lock.fileno(), True)
        if command == "init" and not help_requested:
            initialize(binary, arguments, store, child, lock)
        os.execve(binary, [str(binary), "--dolt-auto-commit=on", *arguments], child)


if __name__ == "__main__":
    try:
        main()
    except (Refusal, OSError, ValueError) as error:
        print(f"work-state: {error}", file=sys.stderr)
        sys.exit(2)

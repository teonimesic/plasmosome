#!/usr/bin/env bash
# A person is accountable for every commit here. A model is a tool that was used, the way an
# editor or a compiler is, and tools do not co-author. The squash keeps a `Co-authored-by` trailer
# naming one, and GitHub shows it as a co-author when it can resolve the address to an account. A
# `Signed-off-by` naming one certifies what a tool cannot.
#
# A trailer credits a model when its address is a listed tool address, or a GitHub noreply address
# whose login is a listed login, such as `coderabbitai[bot]`. When a value has an address, its name
# never makes it a model's, and neither does a vendor's domain, so
# `Claude Monet <claude.monet@corp.locale.io>` and `Jane Doe <jane@anthropic.com>` are people.
# There is no rule for bots: one the list does not name, such as Dependabot, is cleared (spec 029
# section 5).
#
# It also refuses either trailer when it names somebody no reader can trace: a value with no
# address, or an address on a domain no account can sit on, such as `.local`, which is what git
# falls back to on a machine with no `user.email`. A malformed address, such as `<probe@>` or one
# holding a space, counts as no address. So does a value a reader may see as more than one line:
# one holding a line break other than a line feed, or one git unfolded from a trailer that goes on
# over more than one line of the message. A value with no address is refused whatever its name,
# and only a whole vendor word in its name makes the refusal say it credits a model. It reads
# trailers only, not a commit's author or committer (spec 029 section 4).
#
# Runs as a pre-push hook AND as a CI gate, because a hook is bypassable and a gate is not.
# Fails closed: anything it cannot read is a refusal, never a pass.
set -uo pipefail

# Every check here runs in the C locale, so it reads bytes, as git does. In a UTF-8 locale GNU grep
# folds the long s (U+017F) onto `s` under `-i`, which would make a look-alike domain match a
# listed one.
export LC_ALL=C

# Takes rev-list arguments as separate words, so a caller can pass a range, or a tip plus
# `--not --remotes` for a branch the remote has never seen.
if [ "$#" -gt 0 ]; then
  revs=("$@")
elif git rev-parse --verify --quiet origin/main >/dev/null; then
  revs=("origin/main..HEAD")
else
  revs=("HEAD")
fi

# A model tool's own addresses, and its GitHub logins, each compared with the whole address
# (spec 029 section 4 rule 3). Each entry is already escaped for an extended regular expression,
# and each has a probe in `tests/attribution_guard.rs`. The logins' account ids live there, not
# here. The list grows on evidence: a tool's first observed address joins it with its probe, and
# an entry found to be a person's leaves it in its own change. `llama` and `mistral` have no known
# tool address yet.
tool_addresses=(
  'noreply@anthropic\.com'
  'cursoragent@cursor\.com'
  'codex@openai\.com'
  'devin@cognition\.ai'
  'noreply@x\.ai'
)
tool_logins=(
  'claude'
  'claude\[bot\]'
  'copilot'
  'coderabbitai\[bot\]'
  'google-labs-jules\[bot\]'
  'gemini-code-assist\[bot\]'
  'devin-ai-integration\[bot\]'
  'chatgpt-codex-connector\[bot\]'
  'openai-codex\[bot\]'
  'cursor\[bot\]'
  'cursoragent'
)

# Joins its arguments with `|`, as the alternatives of one pattern.
alternatives() {
  local IFS='|'
  printf '%s' "$*"
}

# A listed address, or a GitHub noreply address, with or without the `<id>+` prefix, whose login is
# listed. The guard matches with `-i`, which in the C locale ignores ASCII case alone.
tool_address="^($(alternatives "${tool_addresses[@]}"))\$"
tool_login="^([0-9]+\\+)?($(alternatives "${tool_logins[@]}"))@users\\.noreply\\.github\\.com\$"

# Vendor words. They decide only what the refusal of an identity with no address says. When a value
# has an address, these words never make it a model's. `devin` and `sonnet` are left out, because a
# person may carry either as a name.
vendors='claude|anthropic|gpt|openai|copilot|codex|gemini|llama|mistral|cursor|cognition\.ai|grok|x\.ai'

# The same words, each only as a whole word, so `Claudette Roe <>` is untraceable, not a model. A
# byte outside ASCII counts as part of a word, as an ASCII letter or digit does, so a name where a
# letter outside ASCII follows `Claude` is untraceable too. The guard reads bytes, so it cannot
# tell a letter outside ASCII from a space outside it: a vendor word next to either is not a whole
# word here. Both are refused; only the reason they are given differs.
word_byte="[:alnum:]"$'\x80'"-"$'\xff'
vendor_word="(^|[^$word_byte])($vendors)([^$word_byte]|\$)"

# A domain no account can sit on: the text after the address's last `@` equals a listed name, or
# ends in `.` and one, ignoring one trailing dot. `local` is where git puts a machine with no
# `user.email` (`<user>@<hostname>.local`), and the rest are reserved by RFC 6761 and 8375, by
# ICANN for private use, or held by no registry (spec 029 section 4).
untraceable_domain='@([^@]*\.)?(local|localhost|invalid|test|example|example\.com|example\.net|example\.org|home\.arpa|internal|localdomain)\.?$'

# A malformed address, which counts as no address (spec 029 section 4 rule 2). Its local part is
# the text before its last `@`, and its domain the text after it. Each shape the rule lists has one
# alternative: an empty local part; a domain that, once one trailing dot is removed, is empty,
# starts with a dot, ends with a dot, or holds two dots in a row; and whitespace anywhere. A single
# trailing dot passes, as the domain list ignores it. Any other shape, such as two `@` in a row,
# goes on to the tool list and the domain list. The whitespace is the UTF-8 bytes of the
# characters `blank_to_another_reader` counts as blank, because the guard runs in the C locale, and
# the two sets must stay the same.
blank_bytes="[ "$'\t\r\v\f'"]|"$'\xc2'"["$'\x85\xa0'"]|"$'\xe1\x9a\x80'"|"$'\xe2\x80'"["$'\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\xa8\xa9\xaf'"]|"$'\xe2\x81\x9f'"|"$'\xe3\x80\x80'"|"$'\xef\xbb\xbf'
malformed_address="^@[^@]*\$|@\.?\$|@\.[^@]+\$|\.\.\$|\.\.[^@]+\$|$blank_bytes"

# A line break other than a line feed: a carriage return, a vertical tab, a form feed, U+0085,
# U+2028 or U+2029. Git keeps one inside a trailer's value, and a terminal or a web page may break
# the line there. Then a reader sees a model's trailer on a line of its own, while the value's last
# `<...>` holds a person's address. So a value holding one counts as no address (spec 029 section 4
# rule 2), as a malformed address does.
line_break="["$'\r\v\f'"]|"$'\xc2\x85'"|"$'\xe2\x80'"["$'\xa8\xa9'"]"

# Nominates text worth parsing. Deliberately unanchored: it may only ever over-nominate, because
# a paragraph it skips is a paragraph nothing else looks at.
nominate='(co-authored-by|signed-off-by)[[:space:]]*:'

# Reads a trailer off a line git's parser has already produced, where the key starts the line.
attribution='^[[:space:]]*(co-authored-by|signed-off-by)[[:space:]]*:'
co_author='^[[:space:]]*co-authored-by[[:space:]]*:'

offences=()

# Writes $1 with each byte outside printable ASCII as `\x` and two hex digits. A pattern can hold a
# tab, a carriage return and the bytes of invisible spaces, and printed as they are, they garble or
# hide the line that names it. The loop takes time that grows with the square of its input's
# length in bash, so it is for the guard's own patterns, never for a value from a commit.
visible() {
  local text=$1 shown='' byte code index
  for ((index = 0; index < ${#text}; index++)); do
    byte=${text:index:1}
    case $byte in
      [' '-'~']) shown+=$byte ;;
      *)
        printf -v code '%d' "'$byte"
        printf -v byte '\\x%02x' $((code & 255))
        shown+=$byte
        ;;
    esac
  done
  printf '%s' "$shown"
}

# Answers whether $2 matches $1, and exits the guard if grep could not decide.
#
# `grep -q` exits 0 for a match and 1 for no match; anything higher is a failure to read. Treating
# that as "no match" is how a guard reports clean because its own tooling broke.
matches() {
  local pattern=$1 text=$2 status
  grep -qiE "$pattern" <<<"$text"
  status=$?
  case $status in
    0) return 0 ;;
    1) return 1 ;;
    *)
      echo "attribution-guard: grep exited $status matching '$(visible "$pattern")'"
      echo "Refusing rather than passing: a check this guard cannot run is a check it cannot clear."
      exit 1
      ;;
  esac
}

# Judges the identity on $2, a trailer value under the key on $1, and records an offence if it
# credits a model or names somebody no reader can trace. $3 is set when git unfolded the value from
# more than one line of the message.
#
# The address is the text inside the value's last `<...>`, and the name is what comes before it. An
# identity with no address is refused whatever its name: no account can be found for it. Its name
# decides only what the refusal says. An unfolded value, a value holding a line break and a
# malformed address count as no address, so each is judged by its name before the tool list and
# the domain list. Only the tool list makes an address a model's, and anything the three checks
# leave is a person's or a bot's.
#
# `read` does the splitting and the trimming. Pattern expansions such as `${value##*<}` take time
# that grows with the square of a value's length or worse in bash: a name padded with 5,000 spaces
# took 18 seconds to trim. The `x` keeps a `<` or `>` that ends the value from being dropped as an
# empty last field.
judge_trailer() {
  local position=$1 value=$2 unfolded=${3-} name=$2 address='' segments last closed
  IFS='<' read -r -a segments <<<"${value}x"
  last=${segments[${#segments[@]}-1]}
  IFS='>' read -r -a closed <<<"$last"
  if [ "${#segments[@]}" -gt 1 ] && [ "${#closed[@]}" -gt 1 ]; then
    address=${closed[0]}
    read -r name <<<"${value:0:${#value}-${#last}}"
  fi
  if [ -n "$unfolded" ] || matches "$line_break" "$value" ||
    ! matches '@' "$address" || matches "$malformed_address" "$address"; then
    if matches "$vendor_word" "$name"; then
      offence "$position" "$value" model
    else
      offence "$position" "$value" untraceable
    fi
  elif matches "$tool_address" "$address" || matches "$tool_login" "$address"; then
    offence "$position" "$value" model
  elif matches "$untraceable_domain" "$address"; then
    offence "$position" "$value" untraceable
  fi
}

# Records one refusal line: the position, the value, the stated reason, and the harm it does.
offence() {
  local position=$1 value=$2 verdict=$3 reason harm
  if [ "$verdict" = model ]; then
    reason='credits a model'
    if [ "$position" = Co-authored-by ]; then
      harm='the squash keeps the line, and GitHub shows a co-author for it when it can resolve the address to an account.'
    else
      harm='a sign-off certifies where a change came from, which a tool cannot do.'
    fi
  else
    reason='is untraceable'
    harm='no account can be found for it, so the record on main names somebody no reader can trace.'
  fi
  offences+=("$position \"$value\" $reason: $harm")
}

# Adds every attribution trailer in the paragraph on $1 that credits a model or is untraceable.
#
# A squash merge concatenates the messages it squashes, which leaves the trailers of every commit
# but the last one sitting mid-body. Git's trailer parser reads only the closing paragraph, so it
# does not see them, and a commit shaped that way used to pass. Every paragraph is offered to that
# parser here, not just the last.
#
# The grep only nominates a paragraph; git's parser is what decides. That is the difference
# between this and scanning the raw message, which flagged bodies that merely quoted a trailer.
#
# `--parse` unfolds a trailer that goes on over lines starting with whitespace into one value, and
# a reader of the message sees those lines apart. So when a line of the paragraph starts with
# whitespace, git prints the trailers again as they are written. There, each trailer starts a line,
# and a line starting with a space, a tab or a carriage return, which git's parser counts as
# whitespace, goes on with the trailer above it. Both outputs hold the same trailers in the same
# order, so the count of trailers names which values were unfolded.
record_offending_trailers() {
  local paragraph=$1 parsed written line position value trailer=0 unfolded
  unfolded=()
  matches "$nominate" "$paragraph" || return 0
  if ! parsed=$(printf 'x\n\n%s' "$paragraph" | git interpret-trailers --parse 2>&1); then
    cannot_parse "$parsed"
  fi
  if matches '^[[:space:]]' "$paragraph"; then
    if ! written=$(printf 'x\n\n%s' "$paragraph" | git interpret-trailers --only-trailers --only-input 2>&1); then
      cannot_parse "$written"
    fi
    while IFS= read -r line; do
      case $line in
        [$' \t\r']*) unfolded[trailer]=yes ;;
        *) trailer=$((trailer + 1)) ;;
      esac
    done <<< "$written"
    trailer=0
  fi
  while IFS= read -r line; do
    trailer=$((trailer + 1))
    matches "$attribution" "$line" || continue
    if matches "$co_author" "$line"; then
      position=Co-authored-by
    else
      position=Signed-off-by
    fi
    read -r value <<<"${line#*:}"
    judge_trailer "$position" "$value" "${unfolded[trailer]-}"
  done <<< "$parsed"
}

# Refuses, saying what git said on $1, when git cannot read a paragraph's trailers.
cannot_parse() {
  echo "attribution-guard: cannot parse the trailers of a commit message:"
  echo "$1"
  echo "Refusing rather than passing: a message this guard cannot parse is a message it cannot clear."
  exit 1
}

# Answers whether the line on $1 holds only characters that some reader may call blank: git's
# three, a vertical tab, a form feed and the Unicode spaces. It compares UTF-8 bytes, because the
# guard runs in the C locale. The first test turns an ordinary line away after one pattern match.
# That test alone is not enough: U+30C0, a letter, is made only of bytes from the set. So the
# Unicode spaces are then removed whole, and anything left other than git's three, a vertical tab
# or a form feed makes the line text.
blank_to_another_reader() {
  local rest=$1
  case $rest in
    *[!$' \t\r\v\f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x9a\x9f\xa0\xa8\xa9\xaf\xbb\xbf\xc2\xe1\xe2\xe3\xef']*) return 1 ;;
  esac
  rest=${rest//$'\xc2'[$'\x85\xa0']/}
  rest=${rest//$'\xe1\x9a\x80'/}
  rest=${rest//$'\xe2\x80'[$'\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\xa8\xa9\xaf']/}
  rest=${rest//$'\xe2\x81\x9f'/}
  rest=${rest//$'\xe3\x80\x80'/}
  rest=${rest//$'\xef\xbb\xbf'/}
  case $rest in
    *[!$' \t\r\v\f']*) return 1 ;;
  esac
}

# Splits the message on $1 into paragraphs and offers each to `record_offending_trailers`.
#
# A paragraph ends at a line holding nothing but spaces, tabs and carriage returns, not only at an
# empty one. That is the set git's own parser calls blank, and a message written on Windows
# separates its paragraphs with a line that still holds a carriage return. Splitting only on an
# empty line collapsed such a message into one paragraph, which git then read as prose, so a
# mid-body trailer in it went unseen. Splitting at any other line, such as one holding only a
# vertical tab, cuts a trailer block git reads whole, and the trailers above the cut go unseen.
#
# Another reader may call such a line blank, and split there. So when $2 is set, a line that
# `blank_to_another_reader` accepts ends a paragraph too, and the caller reads a message both ways.
record_offending_trailers_in_message() {
  local message=$1 wide=${2-} line paragraph=''
  matches "$nominate" "$message" || return 0
  while IFS= read -r line; do
    line=${line%$'\r'}
    case $line in
      *[!$' \t\r']*)
        if [ -z "$wide" ] || ! blank_to_another_reader "$line"; then
          paragraph+="$line"$'\n'
          continue
        fi
        ;;
    esac
    record_offending_trailers "$paragraph"
    paragraph=''
  done <<< "$message"
  record_offending_trailers "$paragraph"
}

if ! commits=$(git log --format='%H' "${revs[@]}" 2>&1); then
  echo "attribution-guard: cannot read the range '${revs[*]}':"
  echo "$commits"
  echo "Refusing rather than passing: a range this guard cannot read is a range it cannot clear."
  exit 1
fi

status=0
for sha in $commits; do
  if ! message=$(git show -s --format='%B' "$sha" 2>&1); then
    echo "attribution-guard: cannot read the message of $sha:"
    echo "$message"
    exit 1
  fi
  offences=()
  record_offending_trailers_in_message "$message"
  # Git's reading refused nothing: read again, splitting where another reader may.
  if [ "${#offences[@]}" -eq 0 ]; then
    record_offending_trailers_in_message "$message" wide
  fi
  for refused in "${offences[@]+"${offences[@]}"}"; do
    echo "attribution-guard: ${sha:0:9} $refused"
    status=1
  done
done

if [ "$status" -ne 0 ]; then
  echo
  echo "A person is accountable for every commit here."
  echo "To fix a refused trailer, reword the commit and correct or remove the line:"
  echo "  git rebase -i <base>   # mark the commit 'reword', then correct or remove the trailer line"
  echo "A model is a tool, and tools do not co-author."
  exit 1
fi

echo "attribution-guard: clean"

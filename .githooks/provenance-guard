#!/usr/bin/env bash
# This repository is the product. Its research provenance lives elsewhere and stays there:
# no reference to the private research corpus, its host organisation, or its paths may ship
# here. Runs as a pre-push hook AND as a CI gate, because a hook is bypassable and a gate
# is not.
set -uo pipefail

forbidden=(maestro toptal heavenstudio)
status=0

# `git grep` exits 0 when it finds something, 1 when it does not, and higher when it could not
# look. Collapsing the third into the second is how a guard reports clean because its own search
# broke, so each is answered separately.
for term in "${forbidden[@]}"; do
  hits=$(git grep -In -i -- "$term" -- . ':(exclude).githooks/provenance-guard' 2>&1)
  case $? in
    0)
      echo "provenance-guard: forbidden term '$term' found:"
      echo "$hits"
      status=1
      ;;
    1) ;;
    *)
      echo "provenance-guard: cannot search for '$term':"
      echo "$hits"
      echo "Refusing rather than passing: a search this guard cannot run is a search it cannot clear."
      exit 1
      ;;
  esac
done

if [ "$status" -ne 0 ]; then
  echo
  echo "This tree must not reference the private research corpus. Remove the lines above."
  exit 1
fi

echo "provenance-guard: clean"

#!/usr/bin/env bash
# This repository is the product. Its research provenance lives elsewhere and stays there:
# no reference to the private research corpus, its host organisation, or its paths may ship
# here. Runs as a pre-push hook AND as a CI gate, because a hook is bypassable and a gate
# is not.
set -uo pipefail

forbidden=(maestro toptal heavenstudio)
status=0

for term in "${forbidden[@]}"; do
  hits=$(git grep -In -i -- "$term" -- . ':(exclude).githooks/provenance-guard' 2>/dev/null || true)
  if [ -n "$hits" ]; then
    echo "provenance-guard: forbidden term '$term' found:"
    echo "$hits"
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo
  echo "This tree must not reference the private research corpus. Remove the lines above."
  exit 1
fi

echo "provenance-guard: clean"

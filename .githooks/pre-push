#!/usr/bin/env bash
# git feeds each ref update on stdin as `<local ref> <local sha> <remote ref> <remote sha>`.
# Check what is actually being pushed, not what happens to be on this branch.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/.githooks/provenance-guard" || exit 1

zero="0000000000000000000000000000000000000000"
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  "$root/.githooks/attribution-guard" "$range" || status=1
done

exit "$status"

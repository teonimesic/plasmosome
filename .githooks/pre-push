#!/usr/bin/env bash
# git feeds each ref update on stdin as `<local ref> <local sha> <remote ref> <remote sha>`.
# Check what is actually being pushed, not what happens to be on this branch.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/.githooks/provenance-guard" || exit 1

zero="0000000000000000000000000000000000000000"
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    "$root/.githooks/attribution-guard" "$local_sha" --not --remotes || status=1
  else
    "$root/.githooks/attribution-guard" "$remote_sha..$local_sha" || status=1
  fi
done

exit "$status"
